# Copy this file to .env and adjust. Every value is optional.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Comma separated API keys. Leave empty to run in OPEN public mode (no key required).
RESUME_API_KEYS=

# Comma separated allowed origins, or * for any website.
RESUME_CORS_ORIGINS=*

# Rate limit per IP
RESUME_RATE_WINDOW_MS=60000
RESUME_RATE_MAX=60

# Request body limit
RESUME_MAX_BODY=256kb

# Default template id (see GET /v1/templates)
RESUME_DEFAULT_TEMPLATE=classic

# Footer printed at the bottom of every page
RESUME_FOOTER_TEXT=Generated by Resume Builder
